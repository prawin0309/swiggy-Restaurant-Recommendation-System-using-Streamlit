# Copy to .env (or export these in your shell) to override the defaults.
# .env is gitignored - never commit real credentials.

# Database backend: auto | mysql | sqlite
# auto  -> try MySQL, fall back to SQLite so the project runs anywhere
SWIGGY_DB_BACKEND=auto

SWIGGY_DB_HOST=localhost
SWIGGY_DB_PORT=3306
SWIGGY_DB_USER=root
SWIGGY_DB_PASSWORD=change-me
SWIGGY_DB_NAME=guvi_db
